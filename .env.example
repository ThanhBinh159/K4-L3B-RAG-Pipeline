# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: extractive (offline) | openrouter | openai | gemini | anthropic
LLM_PROVIDER=extractive
LLM_MODEL=
# For OpenRouter chat: LLM_PROVIDER=openrouter, LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional Gemini-compatible gateway, e.g. http://localhost:8317
GEMINI_BASE_URL=
ANTHROPIC_API_KEY=

# Embedding: ollama | local_lsa (offline fallback) | sentence_transformers | openrouter
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
OPENROUTER_API_KEY=
# Run `ollama pull bge-m3` and `ollama serve` before indexing.
OLLAMA_BASE_URL=http://localhost:11434

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=

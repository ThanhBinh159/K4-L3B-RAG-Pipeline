# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: deepseek | openrouter | openai | gemini | anthropic
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Embedding: hash | sentence-transformers | openrouter
# DeepSeek provides generation models, not an embedding API.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=local-hash-1024

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
